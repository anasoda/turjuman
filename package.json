{
  "name": "turjuman-v2",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node scripts/ensure-dist.mjs && wrangler dev --local --port 8787 --var JWT_SECRET:dev-only-jwt-secret-change-me --var ADMIN_BOOTSTRAP_KEY:dev-only-bootstrap-key",
    "dev:web": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply turjuman-v2-db --local",
    "db:seed:local": "node scripts/seed-local.mjs",
    "test:api": "node scripts/smoke-api.mjs && node scripts/smoke-phase2.mjs && node scripts/smoke-phase3.mjs && node scripts/smoke-phase4.mjs && node scripts/smoke-phase5.mjs && node scripts/smoke-phase6.mjs && node scripts/smoke-phase7.mjs && node scripts/smoke-phase8.mjs && node scripts/smoke-phase9.mjs && node scripts/smoke-exams.mjs && node scripts/smoke-ajkam.mjs && node scripts/smoke-circle-day.mjs && node scripts/smoke-plan-history.mjs",
    "test:api:fresh": "node scripts/test-api-fresh.mjs",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-arabic": "^5.0.0",
    "@fontsource/aref-ruqaa": "^5.3.0",
    "@fontsource/noto-kufi-arabic": "^5.0.0",
    "hono": "^4.6.0",
    "html-to-image": "^1.11.13",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260921.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.0.0",
    "fake-indexeddb": "^6.2.5",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vite-plugin-pwa": "^0.21.0",
    "vitest": "^2.1.0",
    "wrangler": "^4.0.0"
  }
}
